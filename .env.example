# Copie para .env e preencha. Nunca envie o .env para o GitHub.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0
ALLOWED_HOSTS=seudominio.com,www.seudominio.com
CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com
HTTPS=1
BEHIND_PROXY=1

# MySQL (se DB_NAME ficar vazio, usa SQLite para testes locais)
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=sua-senha
DB_HOST=localhost
DB_PORT=3306

# So preencha se o front-end ficar em outro dominio (ex.: https://higor.pages.dev)
CORS_ORIGINS=
